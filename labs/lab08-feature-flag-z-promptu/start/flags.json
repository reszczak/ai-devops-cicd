{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "nowy-format-cytatu": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": {
        "if": [
          { "==": [{ "var": "beta" }, "true"] },
          "on",
          {
            "fractional": [
              { "cat": [{ "var": "$flagd.flagKey" }, { "var": "targetingKey" }] },
              ["on", 20],
              ["off", 80]
            ]
          }
        ]
      }
    }
  }
}
